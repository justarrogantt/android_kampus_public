@startuml
skinparam backgroundColor #FFFFFF
skinparam defaultFontName DejaVu Sans
skinparam defaultFontColor #16263C
skinparam defaultFontSize 13
skinparam shadowing false
skinparam ArrowColor #476180
skinparam packageStyle rectangle
skinparam packageBackgroundColor #F5F8FC
skinparam packageBorderColor #A8BACF
skinparam componentStyle rectangle
skinparam componentBackgroundColor #EDF4FC
skinparam componentBorderColor #6D88A6
skinparam rectangleBackgroundColor #EDF4FC
skinparam rectangleBorderColor #6D88A6
skinparam classBackgroundColor #EDF4FC
skinparam classBorderColor #6D88A6
skinparam participantBackgroundColor #EDF4FC
skinparam participantBorderColor #6D88A6
skinparam sequenceLifeLineBorderColor #A8BACF
skinparam stateBackgroundColor #EDF4FC
skinparam stateBorderColor #6D88A6
skinparam activityBackgroundColor #EDF4FC
skinparam activityBorderColor #6D88A6
skinparam noteBackgroundColor #FFFAE9
skinparam noteBorderColor #BB9A65
title YSU Kampus — архитектура приложения

top to bottom direction
actor "Пользователь" as User
actor "Администратор" as Admin
package ":app · Android / Kotlin / Jetpack Compose" {
  component "Точка входа\nMainActivity" as Entry
  component "Вход и восстановление\nfeature.registration" as Auth
  component "Главная и пользовательские функции\nui.main" as Main
  component "Администрирование\nui.admin" as Panel
  component "Репозитории и сессия\ndata.auth, data.session и data.*" as Data
  component "Хранилища\nRoom и SharedPreferences" as Storage
  component "Сеть\nRetrofit, OkHttp, WebSocket" as Network
}
cloud "Бэкенд YSU Kampus\nREST и WebSocket" as Api
cloud "Telegram\nБот и мини-приложение" as Tg
User --> Entry
Admin --> Entry
Entry --> Auth
Auth -down-> Main
Auth -down-> Panel
Auth -right-> Tg : подтверждение и регистрация
Auth ..> Data
Main ..> Data
Panel ..> Data
Data --> Storage
Data --> Network
Network --> Api
@enduml
