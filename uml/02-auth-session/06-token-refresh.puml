@startuml
skinparam backgroundColor #FFFFFF
skinparam defaultFontName DejaVu Sans
skinparam defaultFontColor #16263C
skinparam defaultFontSize 13
skinparam shadowing false
skinparam ArrowColor #476180
skinparam packageStyle rectangle
skinparam packageBackgroundColor #F5F8FC
skinparam packageBorderColor #A8BACF
skinparam componentStyle rectangle
skinparam componentBackgroundColor #EDF4FC
skinparam componentBorderColor #6D88A6
skinparam rectangleBackgroundColor #EDF4FC
skinparam rectangleBorderColor #6D88A6
skinparam classBackgroundColor #EDF4FC
skinparam classBorderColor #6D88A6
skinparam participantBackgroundColor #EDF4FC
skinparam participantBorderColor #6D88A6
skinparam sequenceLifeLineBorderColor #A8BACF
skinparam stateBackgroundColor #EDF4FC
skinparam stateBorderColor #6D88A6
skinparam activityBackgroundColor #EDF4FC
skinparam activityBorderColor #6D88A6
skinparam noteBackgroundColor #FFFAE9
skinparam noteBorderColor #BB9A65
title Общее обновление access-токена

participant "Вызывающий код" as Caller
participant "TokenRefresher" as Ref
database "TokenStorage" as Store
participant "AuthService" as Auth
participant "SessionManager" as Session

note over Caller,Ref
  Один инстанс через TokenRefresherProvider:
  проверка при старте, HTTP до запроса и после 401,
  переподключение WebSocket после отказа авторизации.
end note
Caller -> Ref : refresh(failedToken)
group Mutex.withLock
  Ref -> Store : прочитать текущий access
  alt Access уже заменён другим вызовом
    Ref --> Caller : Success(текущий access)
  else Требуется обновление
    Ref -> Store : прочитать refresh
    opt Refresh-токен существует
      Ref -> Auth : POST auth/refresh
      Auth --> Ref : токены или ошибка
    end
    alt Успех
      Ref -> Store : сохранить access и новый refresh\n(если refresh не вернулся, оставить прежний)
      Ref --> Caller : Success(новый access)
    else Нет refresh или сервер вернул 4xx
      Ref -> Store : clearTokens()
      Ref -> Session : onNotAuthorized()
      Ref --> Caller : SessionExpired
    else Сеть, 5xx или ошибка обработки
      Ref --> Caller : Unavailable
    end
  end
end
@enduml
