@startuml
skinparam backgroundColor #FFFFFF
skinparam defaultFontName DejaVu Sans
skinparam defaultFontColor #16263C
skinparam defaultFontSize 13
skinparam shadowing false
skinparam ArrowColor #476180
skinparam packageStyle rectangle
skinparam packageBackgroundColor #F5F8FC
skinparam packageBorderColor #A8BACF
skinparam componentStyle rectangle
skinparam componentBackgroundColor #EDF4FC
skinparam componentBorderColor #6D88A6
skinparam rectangleBackgroundColor #EDF4FC
skinparam rectangleBorderColor #6D88A6
skinparam classBackgroundColor #EDF4FC
skinparam classBorderColor #6D88A6
skinparam participantBackgroundColor #EDF4FC
skinparam participantBorderColor #6D88A6
skinparam sequenceLifeLineBorderColor #A8BACF
skinparam stateBackgroundColor #EDF4FC
skinparam stateBorderColor #6D88A6
skinparam activityBackgroundColor #EDF4FC
skinparam activityBorderColor #6D88A6
skinparam noteBackgroundColor #FFFAE9
skinparam noteBorderColor #BB9A65
title Общий транспорт WebSocket

hide empty members
abstract class "BaseWebSocketClient<E>" as Base {
  start()
  stop()
  events: SharedFlow<E>
  connectionState: StateFlow<WsConnectionState>
}
class "UserWebSocketClient" as User {
  /ws/user
  parseEvent(payload)
}
class "ModeratorWebSocketClient" as Moderator {
  /ws/moderator
  parseEvent(payload)
}
class TokenRefresher
interface TokenStorage
Base <|-- User
Base <|-- Moderator
Base --> TokenStorage : токен соединения
Base ..> TokenRefresher : отказ авторизации
note top of Base
  Текстовый ping каждые 28 с.
  Задержки реконнекта: 1 / 2 / 5 / 10 / 30 с.
  При 1008 / HTTP 401 / 403 — refresh перед реконнектом.
  После двух подряд таких попыток следующий отказ
  останавливает канал, сохраняя сессию.
  Счётчик сбрасывается при onOpen.
end note
note bottom of User
  Персональные уведомления
end note
note bottom of Moderator
  Новые посты, комментарии
  и счётчик модерации
end note
@enduml
