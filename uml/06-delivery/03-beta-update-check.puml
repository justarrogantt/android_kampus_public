@startuml
skinparam backgroundColor #FFFFFF
skinparam defaultFontName DejaVu Sans
skinparam defaultFontColor #16263C
skinparam defaultFontSize 13
skinparam shadowing false
skinparam ArrowColor #476180
skinparam packageStyle rectangle
skinparam packageBackgroundColor #F5F8FC
skinparam packageBorderColor #A8BACF
skinparam componentStyle rectangle
skinparam componentBackgroundColor #EDF4FC
skinparam componentBorderColor #6D88A6
skinparam rectangleBackgroundColor #EDF4FC
skinparam rectangleBorderColor #6D88A6
skinparam classBackgroundColor #EDF4FC
skinparam classBorderColor #6D88A6
skinparam participantBackgroundColor #EDF4FC
skinparam participantBorderColor #6D88A6
skinparam sequenceLifeLineBorderColor #A8BACF
skinparam stateBackgroundColor #EDF4FC
skinparam stateBorderColor #6D88A6
skinparam activityBackgroundColor #EDF4FC
skinparam activityBorderColor #6D88A6
skinparam noteBackgroundColor #FFFAE9
skinparam noteBorderColor #BB9A65
title Проверка наличия бета-обновления

participant "AuthorizedMainRoute" as Route
participant "BetaUpdateViewModel" as VM
participant "BetaUpdateManager" as Manager
participant "PublicService" as Service
participant "Выбранный бэкенд" as Api

Route -> VM : checkForUpdate()
opt Первая проверка для экземпляра ViewModel
  VM -> Manager : checkForUpdate()
  alt BETA_UPDATES_ENABLED = true
    Manager -> Service : getLatestBetaBuild()
    Service -> Api : GET builds/beta/latest
    Api --> Service : HTTP и манифест, если доступен
    Service --> Manager : ответ
    Manager -> Manager : проверить манифест\nи сравнить versionCode
    Manager --> VM : Available / UpToDate / NotConfigured / Failed
  else Флаг выключен
    Manager --> VM : Disabled
  end
  VM --> Route : BetaUpdateState через StateFlow
end
note over VM,Manager
  HTTP 404 → NotConfigured.
  Только Available открывает шторку
  и показывает обновление в профиле.
end note
@enduml
